# Server-only routes are kept in /server and copied into place by
# scripts/prepare-server-build.mjs (the GitHub Pages build omits them).
/middleware.ts
/app/api/
# /callback needs a page in the static export and a route handler with a server;
# Next.js allows only one, so the directory is generated:
#   build:static -> server/app/callback/static/page.tsx
#   build / dev  -> server/app/callback/route.ts
/app/(auth)/callback/
/app/print/[id]/
/app/s/[token]/
/app/(workspace)/notes/[id]/
/app/(workspace)/folders/[id]/
/app/(workspace)/tags/[slug]/
